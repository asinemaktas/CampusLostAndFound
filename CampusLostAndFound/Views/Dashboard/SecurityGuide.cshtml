@{
    ViewData["Title"] = "Görevli Rehberi";
}

<div class="security-guide-page">
    <header class="security-page-header security-guide-header">
        <div>
            <h1>Görevli Rehberi</h1>
            <p>Eşya teslim sürecinde izlenecek dört adım.</p>
        </div>
    </header>

    <section class="security-guide-grid">
        <article class="security-guide-card">
            <span class="security-guide-number">1</span>
            <h2>Bildirimi Kontrol Et</h2>
            <p>
                Ziyaretçinin gönderdiği fotoğrafı, konumu ve eşya
                bilgilerini inceleyin.
            </p>
        </article>

        <article class="security-guide-card">
            <span class="security-guide-number">2</span>
            <h2>Eşyayı Teslim Al</h2>
            <p>
                Eşya güvenliğe getirildiğinde bildirimi teslim alındı
                olarak işaretleyin.
            </p>
        </article>

        <article class="security-guide-card">
            <span class="security-guide-number">3</span>
            <h2>İlanı Yayımla</h2>
            <p>
                Eşyanın genel ve gizli bilgilerini tamamlayarak bulunan
                eşya ilanını oluşturun.
            </p>
        </article>

        <article class="security-guide-card">
            <span class="security-guide-number">4</span>
            <h2>Teslim Sürecini Tamamla</h2>
            <p>
                Sahiplik talebini değerlendirin ve eşya sahibine
                verildiğinde kaydı arşivleyin.
            </p>
        </article>
    </section>

</div>
