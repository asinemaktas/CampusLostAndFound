@{
    ViewData["Title"] = "Nasıl Çalışır?";
    ViewData["FullWidth"] = true;
}

<section class="student-guide-page">
    <div class="student-guide-container">

        <header class="student-guide-header">
            <span class="student-guide-eyebrow">
                Öğrenci Rehberi
            </span>

            <h1>Kayıp eşyanı güvenle bul ve teslim al</h1>

            <p>
                Bulunan eşyalara göz atın, size ait olduğunu
                düşündüğünüz eşya için talep gönderin ve
                değerlendirme sonucunu takip edin.
            </p>
        </header>

        <div class="student-guide-steps">

            <article class="student-guide-step">
                <div class="student-guide-step-number">1</div>

                <div class="student-guide-step-icon"
                     aria-hidden="true">
                    <svg viewBox="0 0 24 24">
                        <circle cx="11" cy="11" r="7" />
                        <path d="m20 20-4-4" />
                    </svg>
                </div>

                <div class="student-guide-step-content">
                    <span>İlk Adım</span>
                    <h2>Bulunan eşyaları incele</h2>

                    <p>
                        Güvenlik birimine teslim edilen eşyalar
                        arasında kaybettiğiniz eşyayı arayın.
                        Arama, kategori ve bina filtrelerini
                        kullanarak sonuçları daraltabilirsiniz.
                    </p>
                </div>
            </article>

            <article class="student-guide-step">
                <div class="student-guide-step-number">2</div>

                <div class="student-guide-step-icon"
                     aria-hidden="true">
                    <svg viewBox="0 0 24 24">
                        <path d="M6 8h12l1 11H5L6 8Z" />
                        <path d="M9 8V6a3 3 0 0 1 6 0v2" />
                    </svg>
                </div>

                <div class="student-guide-step-content">
                    <span>Eşya Kontrolü</span>
                    <h2>Eşya ayrıntılarını kontrol et</h2>

                    <p>
                        Eşyanın kategorisini, rengini, bulunduğu
                        binayı, konumu ve herkese açık açıklamasını
                        inceleyerek kaybettiğiniz eşyayla
                        karşılaştırın.
                    </p>
                </div>
            </article>

            <article class="student-guide-step">
                <div class="student-guide-step-number">3</div>

                <div class="student-guide-step-icon"
                     aria-hidden="true">
                    <svg viewBox="0 0 24 24">
                        <path d="M5 4h14v16H5z" />
                        <path d="M8 8h8M8 12h8M8 16h5" />
                    </svg>
                </div>

                <div class="student-guide-step-content">
                    <span>Sahiplik Talebi</span>
                    <h2>Ayırt edici bilgi ver</h2>

                    <p>
                        Eşyanın size ait olduğunu düşünüyorsanız
                        sahiplik talebi gönderin. Yalnızca gerçek
                        sahibinin bilebileceği bir özelliği açıkça
                        belirtin.
                    </p>
                </div>
            </article>

            <article class="student-guide-step">
                <div class="student-guide-step-number">4</div>

                <div class="student-guide-step-icon"
                     aria-hidden="true">
                    <svg viewBox="0 0 24 24">
                        <circle cx="12" cy="12" r="8" />
                        <path d="m8.5 12 2.2 2.2 4.8-4.8" />
                    </svg>
                </div>

                <div class="student-guide-step-content">
                    <span>Sonuç ve Teslim</span>
                    <h2>Talebini takip et</h2>

                    <p>
                        Güvenlik görevlisi verdiğiniz bilgileri
                        kontrol eder. Talebiniz kabul edildiğinde
                        eşyanızı güvenlik biriminden teslim
                        alabilirsiniz.
                    </p>
                </div>
            </article>

        </div>
        

    </div>
</section>