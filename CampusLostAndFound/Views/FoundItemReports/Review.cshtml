@using System.Globalization
@model CampusLostAndFound.Models.FoundItemReport

@{
    ViewData["Title"] = "Bildirimi İncele";

    bool hasCoordinates = Model.Latitude.HasValue &&
                          Model.Longitude.HasValue;

    string? mapUrl = null;

    if (hasCoordinates)
    {
        string latitude = Model.Latitude!.Value.ToString(
            CultureInfo.InvariantCulture);

        string longitude = Model.Longitude!.Value.ToString(
            CultureInfo.InvariantCulture);

        mapUrl =
            $"https://www.google.com/maps/search/?api=1&query={latitude},{longitude}";
    }
}

<div class="report-review-page">

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success report-review-success" role="alert">
            @TempData["SuccessMessage"]
        </div>
    }

    <header class="report-review-header">
        <div>
            <h1>Bildirimi İncele</h1>

            <p>
                Bildirim numarası:
                <strong>#@Model.Id</strong>
            </p>
        </div>

        <a asp-controller="FoundItemReports"
           asp-action="Pending"
           class="btn report-review-back-button">
            <svg viewBox="0 0 24 24" aria-hidden="true">
                <path d="m15 18-6-6 6-6" />
            </svg>
            <span>Listeye Dön</span>
        </a>
    </header>

    <article class="report-review-card">

        <section class="report-review-media">
            @if (Model.Status ==
            CampusLostAndFound.Models.FoundItemReportStatus.Pending)
            {
                <span class="report-status-badge report-status-pending">
                    <span aria-hidden="true"></span>
                    Teslim Bekleniyor
                </span>
            }
            else if (Model.Status ==
            CampusLostAndFound.Models.FoundItemReportStatus.Received)
            {
                <span class="report-status-badge report-status-received">
                    <span aria-hidden="true"></span>
                    Güvenlik Teslim Aldı
                </span>
            }

            @if (!string.IsNullOrWhiteSpace(Model.PhotoPath))
            {
                <img src="@Model.PhotoPath"
                     alt="@Model.ItemName" />
            }
            else
            {
                <div class="report-review-photo-placeholder">
                    <svg viewBox="0 0 24 24" aria-hidden="true">
                        <rect x="3" y="5" width="18" height="14" rx="2" />
                        <circle cx="8.5" cy="10" r="1.5" />
                        <path d="m4 17 5-5 4 4 2-2 5 4" />
                    </svg>
                    <span>Fotoğraf bulunamadı</span>
                </div>
            }
        </section>

        <section class="report-review-content">
            <div class="report-review-title">
                <h2>@Model.ItemName</h2>
                <p>Ziyaretçi bildirimi · #@Model.Id</p>
            </div>

            <div class="report-review-details">
                <div class="report-review-detail-row">
                    <span class="report-detail-icon report-detail-icon-warning">
                        <svg viewBox="0 0 24 24" aria-hidden="true">
                            <path d="M6 8h12l1 11H5L6 8Z" />
                            <path d="M9 8V6a3 3 0 0 1 6 0v2" />
                        </svg>
                    </span>

                    <div>
                        <span class="report-detail-label">
                            Ziyaretçi Açıklaması
                        </span>
                        <p>@Model.Description</p>
                    </div>
                </div>

                <div class="report-review-detail-row">
                    <span class="report-detail-icon">
                        <svg viewBox="0 0 24 24" aria-hidden="true">
                            <path d="M20 10c0 5-8 11-8 11S4 15 4 10a8 8 0 1 1 16 0Z" />
                            <circle cx="12" cy="10" r="2.5" />
                        </svg>
                    </span>

                    <div>
                        <span class="report-detail-label">
                            Bulunduğu Yer
                        </span>

                        @if (!string.IsNullOrWhiteSpace(
                        Model.LocationDescription))
                        {
                            <p>@Model.LocationDescription</p>
                        }
                        else
                        {
                            <p class="report-detail-muted">
                                Yazılı yer belirtilmedi.
                            </p>
                        }
                    </div>
                </div>

                <div class="report-review-detail-row">
                    <span class="report-detail-icon">
                        <svg viewBox="0 0 24 24" aria-hidden="true">
                            <path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.4 19.4 0 0 1-6-6A19.8 19.8 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1 1 .4 2 .7 2.9a2 2 0 0 1-.4 2.1L8.1 10a16 16 0 0 0 6 6l1.3-1.3a2 2 0 0 1 2.1-.4c.9.3 1.9.6 2.9.7a2 2 0 0 1 1.6 1.9Z" />
                        </svg>
                    </span>

                    <div>
                        <span class="report-detail-label">İletişim</span>
                        <p>@Model.ContactInformation</p>
                    </div>
                </div>

                <div class="report-review-detail-row">
                    <span class="report-detail-icon">
                        <svg viewBox="0 0 24 24" aria-hidden="true">
                            <circle cx="12" cy="12" r="9" />
                            <path d="M12 7v5l3 2" />
                        </svg>
                    </span>

                    <div>
                        <span class="report-detail-label">
                            Bildirim Tarihi
                        </span>
                        <p>@Model.ReportedAt.ToString("dd.MM.yyyy HH:mm")</p>
                    </div>
                </div>
            </div>

            @if (hasCoordinates)
            {
                <div class="report-review-location">
                    <div>
                        <svg viewBox="0 0 24 24" aria-hidden="true">
                            <path d="M20 10c0 5-8 11-8 11S4 15 4 10a8 8 0 1 1 16 0Z" />
                            <circle cx="12" cy="10" r="2.5" />
                        </svg>
                        <span>Konum bilgisi mevcut</span>
                    </div>

                    <a href="@mapUrl"
                       target="_blank"
                       rel="noopener noreferrer">
                        Haritada Aç
                    </a>
                </div>
            }

            <div class="report-review-action-area">
                @if (Model.Status ==
                CampusLostAndFound.Models.FoundItemReportStatus.Pending)
                {
                    <div class="report-review-info" role="note">
                        <svg viewBox="0 0 24 24" aria-hidden="true">
                            <circle cx="12" cy="12" r="9" />
                            <path d="M12 11v5" />
                            <path d="M12 8h.01" />
                        </svg>

                        <p>
                            Eşyanın fotoğraf ve bildirim bilgileriyle
                            eşleştiğini kontrol edin. Eşya size fiziksel
                            olarak teslim edildiyse aşağıdaki butona basın.
                        </p>
                    </div>

                    <form asp-controller="FoundItemReports"
                          asp-action="MarkReceived"
                          asp-route-id="@Model.Id"
                          method="post">
                        <button type="submit"
                                class="btn report-received-button">
                            <svg viewBox="0 0 24 24" aria-hidden="true">
                                <circle cx="12" cy="12" r="9" />
                                <path d="m8 12 2.5 2.5L16 9" />
                            </svg>
                            <span>Eşyayı Teslim Aldım</span>
                        </button>
                    </form>
                }
                else if (Model.Status ==
                CampusLostAndFound.Models.FoundItemReportStatus.Received)
                {
                    <div class="report-review-received-message" role="status">
                        Bu eşya güvenlik tarafından teslim alındı. Eşya
                        bilgilerini tamamlayarak bulunan eşyalar listesinde
                        yayımlayabilirsiniz.
                    </div>

                    <a asp-area=""
                       asp-controller="FoundItemReports"
                       asp-action="ConvertToFoundItem"
                       asp-route-id="@Model.Id"
                       class="btn report-complete-button">
                        İlan Bilgilerini Tamamla
                    </a>
                }
            </div>
        </section>
    </article>
</div>
