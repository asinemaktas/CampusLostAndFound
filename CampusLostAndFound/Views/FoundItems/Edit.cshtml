@model CampusLostAndFound.Models.FoundItem

@{
    ViewData["Title"] = "Eşya Kaydını Düzenle";
}

<div class="found-item-edit-page">
    <header class="found-item-edit-header">
        <h1>Eşya Kaydını Düzenle</h1>
        <p>Bulunan eşyaya ait bilgileri ve güvenlik ayrıntılarını güncelleyin.</p>
    </header>

    <form asp-action="Edit" method="post" class="found-item-edit-form">
        <div asp-validation-summary="ModelOnly"
             class="alert alert-danger found-item-edit-validation"></div>

        <input type="hidden" asp-for="Id" />
        <input type="hidden" asp-for="IsDelivered" />

        <section class="found-item-edit-section">
            <div class="found-item-edit-section-title">
                <span class="found-item-edit-section-icon" aria-hidden="true">
                    <svg viewBox="0 0 24 24">
                        <path d="M20 13 13 20 4 11V4h7l9 9Z" />
                        <circle cx="8.5" cy="8.5" r="1" />
                    </svg>
                </span>
                <h2>1. Eşya Kimliği ve Sınıflandırma</h2>
                <span class="found-item-required-note">* Zorunlu alanlar</span>
            </div>

            <div class="found-item-edit-section-body found-item-edit-grid found-item-edit-grid-three">
                <div class="found-item-edit-field">
                    <label asp-for="Name">Eşya Adı <span>*</span></label>
                    <input asp-for="Name" class="form-control" />
                    <span asp-validation-for="Name" class="text-danger"></span>
                </div>

                <div class="found-item-edit-field">
                    <label asp-for="Category">Kategori <span>*</span></label>
                    <select asp-for="Category" class="form-select">
                        <option value="">Kategori seçiniz</option>
                        <option value="Cüzdan">Cüzdan</option>
                        <option value="Anahtar">Anahtar</option>
                        <option value="Elektronik">Elektronik</option>
                        <option value="Kart/Belge">Kart / Belge</option>
                        <option value="Çanta">Çanta</option>
                        <option value="Kıyafet">Kıyafet</option>
                        <option value="Diğer">Diğer</option>
                    </select>
                    <span asp-validation-for="Category" class="text-danger"></span>
                </div>

                <div class="found-item-edit-field">
                    <label asp-for="Color">Renk <span>*</span></label>
                    <input asp-for="Color" class="form-control" />
                    <span asp-validation-for="Color" class="text-danger"></span>
                </div>
            </div>
        </section>

        <section class="found-item-edit-section">
            <div class="found-item-edit-section-title">
                <span class="found-item-edit-section-icon" aria-hidden="true">
                    <svg viewBox="0 0 24 24">
                        <path d="M20 10c0 5-8 11-8 11S4 15 4 10a8 8 0 1 1 16 0Z" />
                        <circle cx="12" cy="10" r="2.5" />
                    </svg>
                </span>
                <h2>2. Lokasyon ve Zaman Detayları</h2>
            </div>

            <div class="found-item-edit-section-body found-item-edit-grid found-item-edit-grid-three">
                <div class="found-item-edit-field">
                    <label asp-for="Building">Bulunduğu Bina <span>*</span></label>
                    <input asp-for="Building" class="form-control" />
                    <span asp-validation-for="Building" class="text-danger"></span>
                </div>

                <div class="found-item-edit-field">
                    <label asp-for="FoundLocation">Bulunduğu Yer <span>*</span></label>
                    <input asp-for="FoundLocation" class="form-control" />
                    <span asp-validation-for="FoundLocation" class="text-danger"></span>
                </div>

                <div class="found-item-edit-field">
                    <label asp-for="FoundDate">Bulunma Tarihi ve Saati</label>
                    <input asp-for="FoundDate"
                           asp-format="{0:yyyy-MM-ddTHH:mm}"
                           class="form-control" />
                    <span asp-validation-for="FoundDate" class="text-danger"></span>
                </div>
            </div>
        </section>

        <section class="found-item-edit-section">
            <div class="found-item-edit-section-title">
                <span class="found-item-edit-section-icon" aria-hidden="true">
                    <svg viewBox="0 0 24 24">
                        <path d="M6 3h9l4 4v14H6V3Z" />
                        <path d="M15 3v5h5" />
                        <path d="M9 13h6M9 17h6" />
                    </svg>
                </span>
                <h2>3. Açıklama ve Güvenlik Ayrıntıları</h2>
            </div>

            <div class="found-item-edit-section-body found-item-edit-description-grid">
                <div class="found-item-edit-field">
                    <label asp-for="PublicDescription">Herkese Açık Açıklama <span>*</span></label>
                    <textarea asp-for="PublicDescription"
                              class="form-control"
                              rows="5"></textarea>
                    <span asp-validation-for="PublicDescription" class="text-danger"></span>
                </div>

                <div class="found-item-secret-panel">
                    <div class="found-item-secret-heading">
                        <div>
                            <svg viewBox="0 0 24 24" aria-hidden="true">
                                <rect x="5" y="10" width="14" height="10" rx="2" />
                                <path d="M8 10V7a4 4 0 0 1 8 0v3" />
                            </svg>
                            <label asp-for="SecretDetail">Gizli Ayırt Edici Bilgi</label>
                        </div>
                        <span>Gizli Alan</span>
                    </div>

                    <textarea asp-for="SecretDetail"
                              class="form-control"
                              rows="5"></textarea>
                    <span asp-validation-for="SecretDetail" class="text-danger"></span>

                    <p class="found-item-secret-note">
                        Bu bilgi yalnızca güvenlik görevlileri tarafından sahiplik
                        doğrulaması sırasında kullanılır.
                    </p>
                </div>
            </div>
        </section>

        <div class="found-item-edit-actions">
            <a asp-action="Index" class="btn found-item-edit-back-button">
                Listeye Dön
            </a>
            <button type="submit" class="btn found-item-edit-submit-button">
                Güncelle
            </button>
        </div>
    </form>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
